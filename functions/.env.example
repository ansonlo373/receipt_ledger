# Copy to .env and fill in. .env is gitignored and additionally blocked by
# .githooks/pre-commit — never commit the real file.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash. A full "flash" model rather than
# "flash-lite" because this path exists to read receipts the on-device OCR
# got wrong, so reading quality is the point.
# GEMINI_MODEL=gemini-3.5-flash
